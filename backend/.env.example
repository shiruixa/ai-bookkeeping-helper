# 复制为 backend/.env 并填写。
# 优先级：环境变量 > backend/.env > API_data/令牌_模型.txt > 代码默认值
#
# 想换平台（如参赛要求的中国移动 workbuddy），只改下面三行即可，
# 代码不用动 —— LLM 客户端走的是 OpenAI 兼容接口。

# ---- 当前默认：DMXAPI ----
DEEPSEEK_BASE_URL=https://www.dmxapi.cn/v1
DEEPSEEK_API_KEY=sk-xxxx
MODEL=deepseek-v4-flash-guan

# ---- 换成 workbuddy 时（示例，具体值以平台文档为准）----
# DEEPSEEK_BASE_URL=https://<workbuddy 的接口地址>/v1
# DEEPSEEK_API_KEY=<平台生成的 key>
# MODEL=<平台提供的模型名>
#
# 改完重启后端，然后运行：
#   .venv\Scripts\python.exe scripts\check_llm.py
# 确认输出里显示 "✅ 正在使用 workbuddy"

# 数据文件位置（可选）
# LEDGER_PATH=backend/data/ledger.bean
# DB_PATH=backend/data/app.db
